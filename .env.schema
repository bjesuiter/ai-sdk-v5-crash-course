# @currentEnv=$DEV_ENV
# ---

# Local profile selector. Keep machine-specific selections in gitignored .env.local.
# @type=enum(development, jb, test, production) @sensitive=false
DEV_ENV=development

# Node runtime environment used by Langfuse tracing.
# @optional @sensitive=false
NODE_ENV=

# Base endpoint for opencode zen provider requests.
# @type=url @sensitive=false @auditIgnore
OPENCODE_ZEN_API_ENDPOINT=https://opencode.ai/zen/v1

# Anthropic-compatible opencode zen endpoint.
# @type=url @sensitive=false @auditIgnore
OPENCODE_ENDPOINT_ANTHROPIC=https://opencode.ai/zen/v1/messages

# Google-compatible opencode zen endpoint.
# @type=url @sensitive=false @auditIgnore
OPENCODE_ENDPOINT_GOOGLE=https://opencode.ai/zen/v1/models/gemini-3-pro

# OpenAI-compatible opencode zen endpoint.
# @type=url @sensitive=false @auditIgnore
OPENCODE_ENDPOINT_OPENAI_COMPAT=https://opencode.ai/zen/v1/chat/completions

# API key for opencode zen provider exercises.
# JB profile source: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:OPENCODE_ZEN_API_KEY")
# Desired picker title when supported: Select Keychain Item for OPENCODE_ZEN_API_KEY in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev secret)
# @optional @sensitive @type=string(minLength=1)
OPENCODE_ZEN_API_KEY=

# API key for OpenAI provider exercises.
# JB profile source: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:OPENAI_API_KEY")
# Desired picker title when supported: Select Keychain Item for OPENAI_API_KEY in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev secret)
# @optional @sensitive @type=string(minLength=1) @auditIgnore
OPENAI_API_KEY=

# API key for Anthropic provider exercises.
# JB profile source: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:ANTHROPIC_API_KEY")
# Desired picker title when supported: Select Keychain Item for ANTHROPIC_API_KEY in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev secret)
# @optional @sensitive @type=string(minLength=1) @auditIgnore
ANTHROPIC_API_KEY=

# API key for Google Generative AI provider exercises.
# JB profile source: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:GOOGLE_GENERATIVE_AI_API_KEY")
# Desired picker title when supported: Select Keychain Item for GOOGLE_GENERATIVE_AI_API_KEY in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev secret)
# @optional @sensitive @type=string(minLength=1) @auditIgnore
GOOGLE_GENERATIVE_AI_API_KEY=

# API key for Tavily retrieval/research exercises.
# Optional JB profile source when needed: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:TAVILY_API_KEY")
# Desired picker title when supported: Select Keychain Item for TAVILY_API_KEY in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev secret)
# @optional @sensitive @type=string(minLength=1)
TAVILY_API_KEY=

# GitHub personal access token for MCP GitHub exercises.
# Optional JB profile source when needed: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:GITHUB_PERSONAL_ACCESS_TOKEN")
# Desired picker title when supported: Select Keychain Item for GITHUB_PERSONAL_ACCESS_TOKEN in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev secret)
# @optional @sensitive @type=string(minLength=1)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Langfuse public key for eval/tracing exercises.
# Optional JB profile source when needed: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:LANGFUSE_PUBLIC_KEY")
# Desired picker title when supported: Select Keychain Item for LANGFUSE_PUBLIC_KEY in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev config)
# @optional @type=string(minLength=1) @sensitive=false
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key for eval/tracing exercises.
# Optional JB profile source when needed: keychain(service="varlock", account="ai-sdk-v5-crash-course:jb:LANGFUSE_SECRET_KEY")
# Desired picker title when supported: Select Keychain Item for LANGFUSE_SECRET_KEY in ai-sdk-v5-crash-course
# Supporting prompt/comment metadata when supported: /Users/bjesuiter/Develop/bjesuiter/ai-sdk-v5-crash-course (local dev secret)
# @optional @sensitive @type=string(minLength=1)
LANGFUSE_SECRET_KEY=

# Langfuse base URL for eval/tracing exercises.
# @optional @type=url @sensitive=false
LANGFUSE_BASE_URL=
